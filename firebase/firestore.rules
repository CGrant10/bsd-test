rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleIn(roles) { return signedIn() && request.auth.token.role in roles; }
    match /publicAlerts/{id} {
      allow read: if signedIn();
      allow create: if roleIn(['creator','admin']);
      allow update: if roleIn(['approver','admin']);
      allow delete: if false;
    }
    match /users/{uid} { allow read, update: if signedIn() && request.auth.uid == uid; allow create: if signedIn() && request.auth.uid == uid; }
    match /audit/{id} { allow read: if roleIn(['approver','admin']); allow create: if roleIn(['creator','approver','admin']); allow update, delete: if false; }
  }
}
